#!/usr/bin/env bash
set -euo pipefail
# shellcheck source=/dev/null
source "${DOTAGENTS_GATE_LIB:-$HOME/code/dotagents/gate/gate-lib.sh}" || {
  echo "✗ dotagents gate-lib missing; re-run the agent runtime installer." >&2
  exit 1
}
gate_enter_committing_tree "${BASH_SOURCE[0]}"
gate_require_lib 12
gate_begin_commit "awesome-blog"
run_step "bash floor" gate_check_bash_floor
gate_require_node
run_step "YAML validation" npm run check:yaml
run_step "actionlint" npm run check:actions
run_step "markdown lint" npm run check:md
run_step "smoke scenario" npm run smoke:scenario-contract
run_step "stack protection contracts" npm run test:stack-protection
run_step "infra plan, drift and deploy contracts" npm run test:infra
run_step "Astro and Svelte" npm run gate:app
echo "✓ pre-commit gate complete"
