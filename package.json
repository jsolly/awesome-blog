{
  "name": "blogthedata",
  "private": true,
  "description": "Blogthedata: Astro, Svelte and PagesCMS",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "check:md": "bash scripts/lint-md.sh",
    "check:yaml": "node scripts/check-yaml.mjs",
    "worktree:init": "bash scripts/worktree-init.sh",
    "check:actions": "bash scripts/check-actions.sh",
    "gate": "FLEET_DOC_FAST=0 bash .git-hooks/pre-commit",
    "smoke:production": "node scripts/production-smoke.mjs",
    "smoke:scenario-contract": "node --test scripts/production-smoke-scenario.test.mjs",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check:app": "astro check && svelte-check --tsconfig ./tsconfig.json",
    "test:astro": "node --test scripts/astro-contract.test.mjs",
    "verify:migration": "node scripts/verify-migration.mjs",
    "verify:drafts": "node scripts/verify-drafts.mjs",
    "verify:identities": "node scripts/verify-identities.mjs",
    "verify:cms": "node scripts/verify-cms.mjs",
    "gate:app": "npm run recipes:check && npm run check:app && npm run build && npm run test:astro && npm run test:search && npm run test:browse && npm run test:recipes && npm run verify:cms && npm run verify:drafts && npm run verify:identities",
    "recipes:sync": "node scripts/recipes/sync-recipe-article.mjs && node scripts/recipes/sync-assistant-data.mjs",
    "recipes:check": "node scripts/recipes/sync-recipe-article.mjs --check && node scripts/recipes/sync-assistant-data.mjs --check",
    "test:recipes": "node --test src/components/recipes/*.test.mjs scripts/recipes/*.test.mjs scripts/migration-rewrites.test.mjs",
    "protect:stacks": "bash scripts/protect-stacks.sh",
    "check:stack-protection": "bash scripts/protect-stacks.sh --check",
    "test:stack-protection": "node --test scripts/stack-protection.test.mjs",
    "test:search": "node --test scripts/search.test.mjs",
    "test:browse": "node --test scripts/browse.test.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@internationalized/date": "^3.12.4",
    "@types/node": "26.6.4",
    "@types/sanitize-html": "2.16.2",
    "@types/turndown": "5.0.6",
    "cheerio": "1.2.0",
    "markdownlint-cli2": "0.23.3",
    "playwright": "1.63.0",
    "svelte-check": "4.7.6",
    "tailwind-variants": "3.3.1",
    "turndown": "7.2.4",
    "typescript": "6.0.3",
    "yaml": "2.9.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.2",
    "@astrojs/svelte": "9.0.1",
    "@fontsource/inter": "5.3.0",
    "@fontsource/poppins": "5.3.0",
    "@lucide/svelte": "1.51.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.5",
    "bits-ui": "2.19.5",
    "clsx": "2.1.1",
    "entities": "8.1.0",
    "minisearch": "7.2.0",
    "sanitize-html": "2.18.0",
    "shadcn-svelte": "1.7.0",
    "svelte": "5.57.1",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "zod": "4.6.5"
  },
  "type": "module"
}
