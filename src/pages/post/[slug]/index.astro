---
import Base from '../../../layouts/Base.astro';
import About from '../../../components/About.astro';
import RecipeExperience from '../../../components/recipes/RecipeExperience.astro';
import RecipePwa from '../../../components/recipes/RecipePwa.astro';
import PostCards from '../../../components/PostCards.svelte';
import { blogContent, dateLabel, site } from '../../../lib/content';
import { articleHtml, imageUrl, headingId } from '../../../lib/html';
import { cards } from '../../../lib/cards';
export async function getStaticPaths() { const { posts } = await blogContent(); return posts.map(post => ({ params: { slug: post.data.slug }, props: { post } })); }
const { post } = Astro.props;
const { posts, categories } = await blogContent();
const data = post.data;
const interactiveMealPost = data.slug === '15-minute-dump-and-go-instant-pot-recipes';
const category = categories.find(category => category.data.slug === data.category);
const image = imageUrl(data.image);
const url = `${site}/post/${data.slug}/`;
const postsBySlug = new Map(posts.map(candidate => [candidate.data.slug, candidate]));
const related = data.related.flatMap((slug: string) => {
  const candidate = postsBySlug.get(slug);
  return candidate ? [candidate] : [];
});
const structured = { '@context': 'https://schema.org', '@type': 'BlogPosting', headline: data.title, description: data.description, image: new URL(image, site).href, datePublished: data.published.toISOString(), dateModified: data.updated.toISOString(), author: { '@type': 'Person', name: data.author }, mainEntityOfPage: url };
---
<Base title={data.title} description={data.description} image={image} imageAlt={data.imageAlt} article>
  <Fragment slot="head">{interactiveMealPost && <><link rel="manifest" href="/recipes-pwa/manifest.webmanifest" /><meta name="theme-color" content="#183e2b" /><link rel="apple-touch-icon" href="/recipes-pwa/icon-180.png" /><meta name="apple-mobile-web-app-title" content="Easy Meals" /></>}<meta property="article:published_time" content={data.published.toISOString()} /><meta property="article:modified_time" content={data.updated.toISOString()} /><script type="application/ld+json" set:html={JSON.stringify(structured).replace(/</g, '\\u003c')} /></Fragment>
  <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href={`/category/${data.category}/`}>{category?.data.name}</a></nav>
  <article>
    {interactiveMealPost && <RecipePwa />}
    <h1 id={headingId(data.title)}>{data.title}<a class="heading-link" href={`#${headingId(data.title)}`} aria-label="Link to this heading">#</a></h1>
    {!interactiveMealPost && <figure><img class="article-hero" src={image} alt={data.imageAlt} width={data.imageWidth ?? undefined} height={data.imageHeight ?? undefined} fetchpriority="high" />{data.imageAttribution && <figcaption>{data.imageAttribution}</figcaption>}</figure>}
    {interactiveMealPost ? <RecipeExperience /> : <div class="article-body post-text" set:html={articleHtml(post.html)} />}
    <footer class="post-details">
    <p class="post-meta"><time datetime={data.published.toISOString()}>{dateLabel(data.published)}</time> in <a href={`/category/${data.category}/`}>{category?.data.name}</a></p>
    <p class="post-meta">Updated <time datetime={data.updated.toISOString()}>{dateLabel(data.updated)}</time></p>
    <div class="article-actions share-actions" aria-label="Share this post"><span class="action-label">Share</span>{!interactiveMealPost && <button id="print-article" type="button">Print this post</button>}<a class="action-button" href={`https://twitter.com/intent/tweet/?text=${encodeURIComponent(data.title)}&url=${encodeURIComponent(url)}`} rel="noopener noreferrer" target="_blank" aria-label="Share on X"><img src="/social/xLogo.svg" alt="" width="22" height="22"/></a><a class="action-button" href={`https://www.reddit.com/submit?url=${encodeURIComponent(url)}&title=${encodeURIComponent(data.title)}`} rel="noopener noreferrer" target="_blank" aria-label="Share on Reddit"><img src="/social/redditLogo.svg" alt="" width="22" height="22"/></a><a class="action-button" href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`} rel="noopener noreferrer" target="_blank" aria-label="Share on LinkedIn"><img src="/social/linkedinLogo.svg" alt="" width="22" height="22"/></a></div>
    </footer>
  </article>
  <div class="article-actions"><a class="action-button" href="/">Back to home</a><span id="heading-copy-status" role="status" /></div>
  {related.length > 0 && <section class="related-posts"><h2>Related posts</h2><PostCards posts={cards(related, categories)} /></section>}
  <About />
</Base>
<script>
  document.getElementById('print-article')?.addEventListener('click', () => window.print());
  for (const link of document.querySelectorAll<HTMLAnchorElement>('.heading-link')) {
    link.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(link.href); const status = document.getElementById('heading-copy-status'); if (status) status.textContent = 'Heading link copied.'; } catch { /* Following the fragment remains available without clipboard permission. */ }
    });
  }
</script>
